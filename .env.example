# Copy to .env / .env.dev / .env.local and fill in values.
# Scripts: npm run local (.env.local:4003) | npm run dev (.env.dev:4004) | npm run prod (.env:4005)

# REST API base URL (include trailing /api/v1/)
NEXT_PUBLIC_API_URL=https://your-api-host/api/v1/

# Optional — defaults to origin of NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_SOCKET_URL=https://your-api-host

NEXT_PUBLIC_ADMIN_ACCESS_TOKEN=your-admin-access-token

# development | production
NEXT_PUBLIC_NODE_ENV=development

NEXT_PUBLIC_PROJECT_KEY=your-project-key

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
